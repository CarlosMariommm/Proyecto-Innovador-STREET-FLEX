# Copia este archivo como `.env` (en esta misma carpeta) y completa tus valores.
# El archivo `.env` real NO se sube a GitHub (esta en .gitignore).

# Puerto del servidor (Render/Railway lo asignan solos, no hace falta ahi)
PORT=4000

# Base de datos: cadena de conexion de MongoDB Atlas
DB_URI="mongodb+srv://USUARIO:CONTRASENA@TU-CLUSTER.mongodb.net/streetFlexDB?retryWrites=true&w=majority"

# Firma de las sesiones (JWT). Una cadena larga y al azar, distinta en cada
# entorno. En produccion el servidor no arranca sin ella.
JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# Correo que envia los codigos de verificacion y recuperacion (Gmail con
# "contrasena de aplicacion": Cuenta de Google > Seguridad > Contrasenas de aplicaciones)
USER_EMAIL="tu-correo@gmail.com"
USER_PASSWORD="contrasena-de-aplicacion-de-16-letras"

# Solo en produccion (Render): clave de la API de Brevo (https://brevo.com, plan gratis).
# Render gratis bloquea el SMTP de Gmail, asi que alli los correos salen por esta API.
# USER_EMAIL debe estar verificado como remitente en Brevo. En local se deja vacia.
BREVO_API_KEY=""

# Imagenes de productos (Cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Probador virtual con IA (Replicate)
REPLICATE_API_TOKEN=""

# URL de la web (para los enlaces de los correos y el CORS)
FRONTEND_URL="http://localhost:5173"
