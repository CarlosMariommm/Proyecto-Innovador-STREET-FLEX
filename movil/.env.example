# Direccion publica del backend, con /api al final. Expo la incrusta en la app
# al construirla (las variables EXPO_PUBLIC_* quedan visibles en el APK, por eso
# aqui NUNCA van claves: solo la URL).
#
# Para el APK se pasa con el script:  scripts/generar-apk.ps1 -ApiUrl "https://..."
# Para probar en el celular con Expo Go, copia este archivo como `.env` y ponla aqui.
#
# Si no se define: el emulador de Android usa 10.0.2.2:4000 y el simulador de
# iOS / la web usan localhost:4000.
EXPO_PUBLIC_API_URL=https://TU-API.onrender.com/api
